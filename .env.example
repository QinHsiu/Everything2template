# LLM：deepseek | openai | ollama | custom | auto
# auto = 有 DeepSeek/OpenAI Key 用云端，否则若本机 Ollama 在线则用 Ollama
E2T_LLM_PROVIDER=auto

# DeepSeek（推荐）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Ollama（开源本地，无需 Key）
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# E2T_LLM_PROVIDER=ollama
